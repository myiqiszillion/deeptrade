# DeepChart configuration (copy to .env and adjust)
# The server loads .env automatically (except when NODE_ENV=test, where suites stay hermetic).
# Explicit alternative: node --env-file=.env server/dist/index.js (after pnpm build)

# WebSocket server port
PORT=8080

# Bind address. Keep 127.0.0.1 for local-only access; use 0.0.0.0 to accept remote clients.
HOST=127.0.0.1

# --- Security & Authentication ---
NODE_ENV=development
AUTH_REQUIRED=0
# Required when AUTH_REQUIRED=1 or in production: min 32 chars cryptographically secure secret.
AUTH_JWT_SECRET=
MAX_SESSIONS_PER_USER=3
# Allowed WebSocket origins (comma-separated). Leave empty to allow localhost.
ALLOWED_ORIGINS=
# Development bypass (1 = allow dev bypass when AUTH_REQUIRED=0, strictly disabled in production)
DEV_HOOKS=0

# --- Persistent Storage ---
STORAGE_PATH=./data/market_data.sqlite

# Frontend -> backend WebSocket URL
VITE_WS_URL=ws://localhost:8080

# Test port used by the self-contained verify_p0.ts suite
TEST_PORT=8089

# --- Public / free deployment knobs ---
# Max simultaneous client sessions before new connections are refused
MAX_SESSIONS=500
# Per-client inbound message limit (flood protection)
MAX_MESSAGES_PER_SEC=40
# Max inbound WebSocket frame size in bytes
MAX_PAYLOAD_BYTES=65536
# Path to the built client (served on the same port as the WebSocket)
CLIENT_DIST=./client/dist

# --- Futures & Market Data (Databento) ---
# Which licensed vendor serves CME futures, OPRA options, and equities.
# Options: 'databento' | 'none'
FUTURES_PROVIDER=databento

# Default symbol for chart sessions and subscriptions
DEFAULT_SYMBOL=ES


# Databento API credentials & endpoints
DATABENTO_API_KEY=
DATABENTO_HIST_URL=https://hist.databento.com/v0
DATABENTO_LIVE_URL=wss://live.databento.com/v0
DATABENTO_DATASET_FUTURES=GLBX.MDP3
DATABENTO_DATASET_OPTIONS=OPRA.PILLAR
DATABENTO_DATASET_EQUITIES=XNAS.ITCH
DATABENTO_SYMBOLS=ES,NQ,MES,MNQ,SPY,QQQ

# --- TimescaleDB & Redis ---
DATABASE_URL=postgresql://deepchart:deepchart@localhost:5432/deepchart
REDIS_URL=redis://localhost:6379

# FREE crypto feed (no key, no cost): these symbols stream trades + 20-level depth + klines
# history from Binance public endpoints, regardless of FUTURES_PROVIDER. Coexists with CME feeds.
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT

# Historical depth per timeframe requested on subscribe (100..5000). Deeper = more history cached in SQLite.
HISTORY_BARS_TARGET=1500

# Any other CME Group root with verified spec (CME contract specs page):
#   SYMBOL:POINT_VALUE:TICK_SIZE[:NAME[:CATEGORY[:EXCHANGE[:UNDERLYING_INDEX]]]]  (';'-separated)
# Example: EXTRA_INSTRUMENTS="QM:500:0.025:E-mini Crude Oil:ENERGY:NYMEX:CL;ZG:100:0.1:E-mini Gold:METALS:COMEX"
EXTRA_INSTRUMENTS=

CBOE_TTL_MS=600000
CBOE_MAX_DTE=60
GEX_REFRESH_MS=300000

# --- Accounts & authentication (required for a paid deployment) ---
# AUTH_JWT_SECRET is mandatory when NODE_ENV=production or AUTH_REQUIRED=1 (32+ chars, fail-fast).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_USERNAME/ADMIN_PASSWORD bootstrap the operator account at every boot (role=admin, elite plan).
# ADMIN_SECRET guards /api/v1/admin/* and mints an admin token at POST /api/v1/auth/login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET=

# --- Billing (Stripe; optional — omit to sell manually via the admin API) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
STRIPE_WEBHOOK_SECRET=

# --- Watchlist quote board (OPT-IN: metered vendor data, cached per symbol per TTL) ---
# 1 = the watchlist can show last-trade quotes for up to 8 rows (cached, with data age shown).
ENABLE_QUOTE_BOARD=0
# Cache lifetime for watchlist quotes (>= 5000 ms; default 60000). Client polls every 15s.
QUOTE_BOARD_TTL_MS=60000

# --- Abuse limits & observability ---
# Token protecting /metrics in production (leave empty in development for open access)
METRICS_TOKEN=
# Per-IP REST budget, and the stricter budget for /api/v1/auth/*
MAX_API_REQUESTS_PER_MIN=240
MAX_AUTH_REQUESTS_PER_MIN=15
# Per-account budget for billable vendor history pulls (cost protection)
MAX_VENDOR_FETCHES_PER_HOUR=120
# Credential brute-force policy: failures before lockout, counting window, lock duration
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
# 1 = trust X-Forwarded-For (only behind a reverse proxy you control)
TRUST_PROXY=0
# plain | json (json emits one structured log object per line)
LOG_FORMAT=plain
# HSTS header is sent automatically when NODE_ENV=production; force it with 1
ENABLE_HSTS=0

# --- Storage housekeeping ---
# 0 keeps everything; 30 purges trades/bars/gaps older than 30 days every maintenance pass
STORE_RETENTION_DAYS=30
# Bars get their own (usually longer) window: candles are tiny and preserved for chart history.
# Defaults to STORE_RETENTION_DAYS when unset. 365 keeps a year of chart history offline.
STORE_BARS_RETENTION_DAYS=365
STORE_MAINTENANCE_INTERVAL_MS=900000
STORE_MAINTENANCE_INITIAL_DELAY_MS=60000
# 1 = run one VACUUM per day (reclaims space after retention deletes)
STORE_VACUUM=1
