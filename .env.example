# DeepChart configuration (copy to .env and adjust)
# The server loads .env automatically (except when NODE_ENV=test, where suites stay hermetic).
# Explicit alternative: node --env-file=.env server/dist/index.js (after pnpm build)

# WebSocket server port
PORT=8080

# Bind address. Keep 127.0.0.1 for local-only access; use 0.0.0.0 to accept remote clients.
HOST=127.0.0.1

# --- Security & Authentication ---
NODE_ENV=development
AUTH_REQUIRED=0
# Required when AUTH_REQUIRED=1 or in production: min 32 chars cryptographically secure secret.
AUTH_JWT_SECRET=
MAX_SESSIONS_PER_USER=3
# Allowed WebSocket origins (comma-separated). Leave empty to allow localhost.
ALLOWED_ORIGINS=
# Development bypass (1 = allow dev bypass when AUTH_REQUIRED=0, strictly disabled in production)
DEV_HOOKS=0

# --- Persistent Storage ---
STORAGE_PATH=./data/market_data.sqlite

# Frontend -> backend WebSocket URL
VITE_WS_URL=ws://localhost:8080

# Test port used by the self-contained verify_p0.ts suite
TEST_PORT=8089

# --- Public / free deployment knobs ---
# Max simultaneous client sessions before new connections are refused
MAX_SESSIONS=500
# Per-client inbound message limit (flood protection)
MAX_MESSAGES_PER_SEC=40
# Max inbound WebSocket frame size in bytes
MAX_PAYLOAD_BYTES=65536
# Path to the built client (served on the same port as the WebSocket)
CLIENT_DIST=./client/dist
# --- Futures market data (REAL vendors only) ---
# Which licensed vendor serves ES/NQ/YM/RTY/GC/CL/NG. Default 'none' = those instruments
# report FEED: UNAVAILABLE. DeepChart has no synthetic/reconstructed fallback by design.
FUTURES_PROVIDER=none
# Databento credentials (server-side only, never committed). Set FUTURES_PROVIDER=databento to stream.
# Dataset defaults to GLBX.MDP3 (CME futures). Symbols default to front-month continuous (ES.c.0, NQ.c.0, ...).
DATABENTO_API_KEY=
DATABENTO_DATASET=GLBX.MDP3
# Vendor symbology: continuous (e.g. ES.c.0) or parent (e.g. ES.FUT)
DATABENTO_STYPE_IN=continuous
# Explicit symbol override. Leave empty to use default continuous front month for active instrument.
DATABENTO_SYMBOLS=
# Historical depth per timeframe requested on subscribe (100..5000). Deeper = more metered cost once,
# then cached in SQLite and served from disk. 1500 is ~1 day of 1m / ~4 days of 5m bars per symbol.
HISTORY_BARS_TARGET=1500
# Metered-spend guard (the $199/month subscription does NOT cap per-GB historical pulls).
# DATABENTO_MONTHLY_USD_BUDGET: hard ceiling for pay-as-you-go history pulls per calendar month (0 = no cap).
#   Before each paid request the server asks POST /v0/metadata.get_cost; requests that would exceed the
#   budget are refused (cached bars are still served) and logged. See docs/DATABENTO.md.
# DATABENTO_COST_LOG=1: log/record the estimate without enforcing a ceiling.
DATABENTO_MONTHLY_USD_BUDGET=0
DATABENTO_COST_LOG=0
# Any other CME Group root served by GLBX.MDP3, with YOUR verified spec (CME contract specs page):
#   SYMBOL:POINT_VALUE:TICK_SIZE[:NAME[:CATEGORY[:EXCHANGE[:UNDERLYING_INDEX]]]]  (';'-separated)
# Example: EXTRA_INSTRUMENTS="QM:500:0.025:E-mini Crude Oil:ENERGY:NYMEX:CL;ZG:100:0.1:E-mini Gold:METALS:COMEX"
# Invalid rows are logged ([Instruments] EXTRA_INSTRUMENTS rejected -> ...) and skipped, never guessed.
EXTRA_INSTRUMENTS=
# 1 = pull every GLBX.MDP3 instrument definition at boot (one metered request, spend-guarded) so the picker
# covers the whole CME Group product list; results are stored and reapplied on later boots without network.
# Manual refresh: POST /api/v1/admin/instruments/sync   Inspect: GET /api/v1/admin/instruments/specs
SYNC_INSTRUMENTS_ON_BOOT=0
# Hard cap for a definition pull (ms). ALL_SYMBOLS on GLBX.MDP3 is large: the request aborts after this.
DEFINITIONS_TIMEOUT_MS=300000

# --- Tradovate (REAL CME market data: quotes + DOM) ---
# Set FUTURES_PROVIDER=tradovate to enable. Credentials are server-side only: they are never
# logged, never placed in a status reason and never sent to the browser.
# TRADOVATE_ENV=demo|live  (demo = demo.tradovateapi.com, live = live.tradovateapi.com)
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
# App credentials issued in the Tradovate developer portal
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0.0
# Client/application id and secret issued for your API application (not a cluster selector)
TRADOVATE_CID=
TRADOVATE_SEC=
# Optional: pin an explicit contract month (e.g. ESZ6). Empty = continuous front month (@ES).
TRADOVATE_SYMBOL=
# Optional: 1 = stream the micro root (MES/MNQ/M2K/MGC/MCL) instead of the full-size contract
TRADOVATE_USE_MICRO=0

CBOE_TTL_MS=600000
CBOE_MAX_DTE=60
GEX_REFRESH_MS=300000

# --- Accounts & authentication (required for a paid deployment) ---
# AUTH_JWT_SECRET is mandatory when NODE_ENV=production or AUTH_REQUIRED=1 (32+ chars, fail-fast).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_USERNAME/ADMIN_PASSWORD bootstrap the operator account at every boot (role=admin, elite plan).
# ADMIN_SECRET guards /api/v1/admin/* and mints an admin token at POST /api/v1/auth/login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET=

# --- Billing (Stripe; optional — omit to sell manually via the admin API) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
STRIPE_WEBHOOK_SECRET=

# --- Watchlist quote board (OPT-IN: metered vendor data, one paid pull per symbol per TTL) ---
# 1 = the watchlist can show last-trade quotes for up to 8 rows (cached, with data age shown).
ENABLE_QUOTE_BOARD=0
# Cache lifetime for watchlist quotes (>= 5000 ms; default 60000). Client polls every 15s.
QUOTE_BOARD_TTL_MS=60000

# --- Abuse limits & observability ---
# Token protecting /metrics in production (leave empty in development for open access)
METRICS_TOKEN=
# Per-IP REST budget, and the stricter budget for /api/v1/auth/*
MAX_API_REQUESTS_PER_MIN=240
MAX_AUTH_REQUESTS_PER_MIN=15
# Per-account budget for billable vendor history pulls (cost protection)
MAX_VENDOR_FETCHES_PER_HOUR=120
# Credential brute-force policy: failures before lockout, counting window, lock duration
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
# 1 = trust X-Forwarded-For (only behind a reverse proxy you control)
TRUST_PROXY=0
# plain | json (json emits one structured log object per line)
LOG_FORMAT=plain
# HSTS header is sent automatically when NODE_ENV=production; force it with 1
ENABLE_HSTS=0

# --- Storage housekeeping ---
# 0 keeps everything; 30 purges trades/bars/gaps older than 30 days every maintenance pass
STORE_RETENTION_DAYS=30
# Bars get their own (usually longer) window: candles are tiny and expensive to re-pull once paid for.
# Defaults to STORE_RETENTION_DAYS when unset. 365 keeps a year of chart history offline.
STORE_BARS_RETENTION_DAYS=365
STORE_MAINTENANCE_INTERVAL_MS=900000
STORE_MAINTENANCE_INITIAL_DELAY_MS=60000
# 1 = run one VACUUM per day (reclaims space after retention deletes)
STORE_VACUUM=1

