# DeepChart configuration (copy to .env and adjust)
# The server does not auto-load .env. Export these variables, or from the repo root run:
# node --env-file=.env server/dist/index.js (after pnpm build)

# WebSocket server port
PORT=8080

# Bind address. Keep 127.0.0.1 for local-only access; use 0.0.0.0 to accept remote
# clients (there is NO authentication yet, so only do this on a trusted network).
HOST=127.0.0.1

# Frontend -> backend WebSocket URL
VITE_WS_URL=ws://localhost:8080

# Demo data: 1 = seed sample prop-account history / journal trades for UI demos
DEMO=0

# Dev hooks: 1 = allow SET_PROP_CONFIG over WebSocket (testing only, never in production)
DEV_HOOKS=0

# Test port used by the self-contained verify_p0.ts suite
TEST_PORT=8089

# --- Public / free deployment knobs ---
# Max simultaneous client sessions before new connections are refused
MAX_SESSIONS=500
# Per-client inbound message limit (flood protection)
MAX_MESSAGES_PER_SEC=40
# Max inbound WebSocket frame size in bytes
MAX_PAYLOAD_BYTES=65536
# Path to the built client (served on the same port as the WebSocket)
CLIENT_DIST=./client/dist
# --- Futures market data (REAL vendors only) ---
# Which licensed vendor serves ES/NQ/YM/RTY/GC/CL/NG. Default 'none' = those instruments
# report FEED: UNAVAILABLE. DeepChart has no synthetic/reconstructed fallback by design.
FUTURES_PROVIDER=none
# Databento credentials (server-side only, never committed). The adapter still reports
# UNAVAILABLE until a spec-verified DBN transport is implemented — it refuses to guess.
DATABENTO_API_KEY=
DATABENTO_DATASET=
# Vendor symbology: parent/continuous config and explicit symbol override, e.g. ES.FUT
DATABENTO_STYPE_IN=parent
DATABENTO_SYMBOLS=

# --- Tradovate (REAL CME market data: quotes + DOM) ---
# Set FUTURES_PROVIDER=tradovate to enable. Credentials are server-side only: they are never
# logged, never placed in a status reason and never sent to the browser.
# TRADOVATE_ENV=demo|live  (demo = demo.tradovateapi.com, live = live.tradovateapi.com)
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
# App credentials issued in the Tradovate developer portal
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0.0
# Client/application id and secret issued for your API application (not a cluster selector)
TRADOVATE_CID=
TRADOVATE_SEC=
# Optional: pin an explicit contract month (e.g. ESZ6). Empty = continuous front month (@ES).
TRADOVATE_SYMBOL=
# Optional: 1 = stream the micro root (MES/MNQ/M2K/MGC/MCL) instead of the full-size contract
TRADOVATE_USE_MICRO=0

CBOE_TTL_MS=600000
CBOE_MAX_DTE=60
GEX_REFRESH_MS=300000
