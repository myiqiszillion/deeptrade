{
  "name": "deepchart",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "pnpm --filter @deepchart/server dev",
    "dev:client": "pnpm --filter client dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "build": "pnpm --filter @deepchart/server build && pnpm --filter client build",
    "typecheck": "pnpm --filter @deepchart/server exec tsc -p tsconfig.test.json --noEmit && pnpm --filter client exec tsc -p tsconfig.app.json --noEmit && pnpm --filter client exec tsc -p tsconfig.node.json --noEmit",
    "lint": "pnpm --filter client lint",
    "test:offline": "pnpm verify:types && pnpm verify:phase_a && pnpm verify:phase_b && pnpm verify:phase_c && pnpm verify:phase_d_e && pnpm verify:viewport && pnpm verify:phase1 && pnpm verify:footprint && pnpm verify:replay && pnpm verify:feed && pnpm verify:lifecycle && pnpm verify:tradovate",
    "test:integration": "pnpm verify:chart-smoke && pnpm verify:p0",
    "test:live": "pnpm verify",
    "verify": "pnpm --filter @deepchart/server exec tsx src/verify_e2e.ts",
    "verify:p0": "pnpm --filter @deepchart/server exec tsx src/verify_p0.ts",
    "verify:feed": "pnpm --filter @deepchart/server exec tsx src/verify_feed.ts",
    "verify:tradovate": "pnpm --filter @deepchart/server exec tsx src/verify_tradovate.ts",
    "verify:chart-smoke": "node server/verify_chart_smoke.mjs",
    "verify:lifecycle": "pnpm --filter @deepchart/server exec tsx src/verify_lifecycle.ts",
    "verify:footprint": "pnpm --filter @deepchart/server exec tsx src/verify_footprint.ts",
    "verify:replay": "pnpm --filter @deepchart/server exec tsx src/verify_replay.ts",
    "verify:viewport": "pnpm --filter @deepchart/server exec tsx src/verify_viewport.ts",
    "verify:phase1": "pnpm --filter @deepchart/server exec tsx src/verify_phase1.ts",
    "verify:phase_a": "pnpm --filter @deepchart/server exec tsx src/verify_phase_a.ts",
    "verify:phase_b": "pnpm --filter @deepchart/server exec tsx src/verify_phase_b.ts",
    "verify:phase_c": "pnpm --filter @deepchart/server exec tsx src/verify_phase_c.ts",
    "verify:phase_d_e": "pnpm --filter @deepchart/server exec tsx src/verify_phase_d_e.ts",
    "verify:types": "node scripts/check-protocol-drift.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@12.4.2"
}
