# Caddy terminates TLS (Let's Encrypt) and proxies API/WS traffic to the app,
# while serving the frontend SPA static files.
# Set DOMAIN in .env — a public hostname gets a real certificate automatically.
{$DOMAIN:localhost} {
	encode zstd gzip

	# Security headers are also sent by the app; keeping them here covers proxied responses too.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	@api {
		path /api/* /healthz /metrics
	}
	reverse_proxy @api app:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Long-lived WebSocket upgrades on the same origin.
	@ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @ws app:8080

	handle {
		root * /var/www/html
		try_files {path} /index.html
		file_server
	}
}
